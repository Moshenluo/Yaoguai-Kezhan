# ============================================================
# 飞书应用凭证（开放平台 → 创建企业自建应用 → 凭证与基础信息）
# https://open.feishu.cn/app
# ============================================================
FEISHU_APP_ID=cli_xxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 国际版 Lark 用户请取消注释下一行
# FEISHU_DOMAIN=https://open.larksuite.com

# ============================================================
# 群自定义机器人 Webhook（群设置 → 群机器人 → 添加自定义机器人）
# ============================================================
FEISHU_BOT_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 可选：群机器人签名校验密钥（开启签名校验时填写）
FEISHU_BOT_SECRET=

# ============================================================
# 应用事件订阅 Webhook 服务（需公网地址，本地开发可用 ngrok）
# ============================================================
FEISHU_WEBHOOK_PORT=3000
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=

# ============================================================
# 浏览器自动化（Playwright）
# ============================================================
FEISHU_WEB_URL=https://www.feishu.cn/next/messenger/
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_USER_DATA_DIR=./.playwright/feishu-profile
