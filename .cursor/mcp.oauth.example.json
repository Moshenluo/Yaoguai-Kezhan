{
  "mcpServers": {
    "lark-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@larksuiteoapi/lark-mcp",
        "mcp",
        "-a",
        "cli_xxxxxxxxxx",
        "-s",
        "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
        "--oauth",
        "--token-mode",
        "user_access_token"
      ]
    }
  }
}
